    "test": "yarn workspace dsh-plugin-desktop test && yarn workspace dsh-community-market test",
    "check:layout": "node scripts/verify-documentation-boundary.mjs && node scripts/verify-layout.mjs",
    "check:docs": "node scripts/verify-documentation-boundary.mjs",
    "test:housekeeping": "node scripts/run-isolated-check.mjs node:test scripts/run-isolated-check.spec.mjs scripts/prepare-test-electron.spec.mjs scripts/verify-documentation-boundary.spec.mjs",
