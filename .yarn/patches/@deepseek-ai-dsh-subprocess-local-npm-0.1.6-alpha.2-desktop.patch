 /**
+* Desktop patch: run the Windows Job runner as Node when the Host is Electron.
+* In a plain Node process this returns the alpha.2 environment unchanged; under
+* Electron it copies the env, drops any case variant of ELECTRON_RUN_AS_NODE, and
+* sets only the canonical key so the runner executes as Node. The variable stays on
+* the runner's own process env only; the Target_Command is spawned from the separate
+* IPC targetEnv and process.env is never mutated.
+* @param env - runner environment produced by runnerEnvironment().
+* @returns the runner environment, augmented only under Electron.
+*/
+function withElectronRunAsNode(env) {
+	if (process.versions.electron === void 0) return env;
+	const next = { ...env };
+	for (const name of Object.keys(next)) {
+		if (name.toUpperCase() === "ELECTRON_RUN_AS_NODE") Reflect.deleteProperty(next, name);
+	}
+	next.ELECTRON_RUN_AS_NODE = "1";
+	return next;
+}
