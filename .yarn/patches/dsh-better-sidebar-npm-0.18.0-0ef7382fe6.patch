new file mode 100644
index 0000000000000000000000000000000000000000..724d144ec0d4cbf3839a9ff862a5ff73db11ad72
--- /dev/null
+++ b/src/client/menu-placement.ts
@@ -0,0 +1,90 @@
+import { createElement, useId, useLayoutEffect } from 'react'
+import type { MenuEntry } from '@deepseek-ai/dsh-client-ui-primitives'
+
+/** Geometry for an owned submenu; real dimensions replace a global body heuristic. */
+export function placeSidebarSubmenu(parent: { left: number; right: number; bottom: number }, width: number, height: number, vw: number, vh: number) {
+  const margin = 12
+  const maxWidth = Math.max(1, vw - margin * 2)
+  const maxHeight = Math.max(1, vh - margin * 2)
+  const w = Math.min(width, maxWidth), h = Math.min(height, maxHeight)
+  const gap = height > maxHeight ? 0 : 10
+  const fitsRight = parent.right + gap + w <= vw - margin
+  const fitsLeft = parent.left - gap - w >= margin
+  const side = fitsRight ? 'right' : fitsLeft ? 'left' : 'overlap'
+  const proposed = side === 'left' ? parent.left - gap - w : parent.right + gap
+  return {
+    left: Math.max(margin, Math.min(proposed, vw - margin - w)),
+    top: Math.max(margin, Math.min(parent.bottom + 4 - h, vh - margin - h)),
+    maxWidth, maxHeight, side,
+  }
+}
+
+/** Mark only this menu's rows, including when Menu portals its list to body. */
+export function markSidebarMenuItems(items: readonly MenuEntry[], owner: string): MenuEntry[] {
+  return items.map(item => 'label' in item
+    ? { ...item, label: createElement('span', { 'data-dsh-sidebar-menu-owner': owner }, item.label) }
+    : item)
+}
+
+export function useSidebarSubmenuPlacement(menu: { x: number; y: number } | null): string {
+  const owner = useId()
+  useLayoutEffect(() => {
+    if (menu === null) return
+    const previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null
+    const originals = new Map<HTMLElement, { style: string | null; side: string | null }>()
+    const roots = new Set<Element>()
+    const place = () => {
+      roots.clear()
+      for (const marker of document.querySelectorAll('[data-dsh-sidebar-menu-owner]')) {
+        if (marker.getAttribute('data-dsh-sidebar-menu-owner') !== owner) continue
+        const root = marker.closest('[role="menu"]')
+        if (root) roots.add(root)
+      }
+      for (const root of roots) for (const submenu of root.querySelectorAll<HTMLElement>('[role="menu"]')) {
+        const parent = submenu.parentElement
+        if (!parent) continue
+        if (!originals.has(submenu)) originals.set(submenu, { style: submenu.getAttribute('style'), side: submenu.getAttribute('data-dsh-sidebar-submenu-side') })
+        // Remove a prior cap while measuring its natural content after resize.
+        submenu.style.maxHeight = 'none'
+        submenu.style.maxWidth = `${Math.max(1, window.innerWidth - 24)}px`
+        const rect = submenu.getBoundingClientRect()
+        const naturalHeight = Math.max(rect.height, submenu.scrollHeight)
+        const placement = placeSidebarSubmenu(parent.getBoundingClientRect(), rect.width, naturalHeight, window.innerWidth, window.innerHeight)
+        Object.assign(submenu.style, {
+          position: 'fixed', left: `${placement.left}px`, top: `${placement.top}px`, bottom: 'auto', right: 'auto',
+          maxWidth: `${placement.maxWidth}px`, maxHeight: `${placement.maxHeight}px`,
+          overflowY: naturalHeight > placement.maxHeight ? 'auto' : 'visible',
+        })
+        submenu.setAttribute('data-dsh-sidebar-submenu-side', placement.side)
+      }
+    }
+    const observer = new MutationObserver(records => {
+      if (records.some(record => record.type === 'childList' || roots.has(record.target as Element))) place()
+    })
+    const restoreFocus = (event: KeyboardEvent) => {
+      if (event.key !== 'Escape' || !previousFocus?.isConnected) return
+      if (![...roots].some(root => root.contains(document.activeElement))) return
+      queueMicrotask(() => {
+        if (previousFocus.isConnected) previousFocus.focus({ preventScroll: true })
+      })
+    }
+    // Menu updates its portaled list position in a layout effect. Observe that
+    // root's style too, but ignore our submenu's own style writes to avoid a loop.
+    observer.observe(document.body, { subtree: true, childList: true, attributes: true, attributeFilter: ['style'] })
+    window.addEventListener('resize', place)
+    window.addEventListener('scroll', place, true)
+    document.addEventListener('keydown', restoreFocus, true)
+    place()
+    return () => {
+      observer.disconnect()
+      window.removeEventListener('resize', place)
+      window.removeEventListener('scroll', place, true)
+      document.removeEventListener('keydown', restoreFocus, true)
+      for (const [element, original] of originals) {
+        if (original.style === null) element.removeAttribute('style'); else element.setAttribute('style', original.style)
+        if (original.side === null) element.removeAttribute('data-dsh-sidebar-submenu-side'); else element.setAttribute('data-dsh-sidebar-submenu-side', original.side)
+      }
+    }
+  }, [menu, owner])
+  return owner
+}
