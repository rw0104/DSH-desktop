+import type { Context } from '@deepseek-ai/cordis'
+import { installModelSelection as installSidechatModelBinding, type Agent, type ModelSelection } from '@deepseek-ai/dsh-agent'
+import { ReasoningEffortId as sidechatReasoningEffortId } from '@deepseek-ai/dsh-llm'
+
+/** Bind the persisted RC1 selection after a raw AgentRegistry create/resume. */
+export function installSidechatModelSelection(host: Context, agentCtx: Context): void {
+  const agent = agentCtx.agent
+  if (agent === undefined) throw new Error('Sidechat setup has no scoped Agent')
+  const services = host as unknown as { get(name: string): unknown }
+  const projections = services.get('sessionProjections') as {
+    stateOf(session: Agent['session'], key: string): { pending: ModelSelection | null; lastUsed: ModelSelection | null } | undefined
+  } | undefined
+  const defaults = services.get('agentDefaultModel') as { currentSelection(): ModelSelection } | undefined
+  installSidechatModelBinding(agentCtx, {
+    get current() {
+      const projected = projections?.stateOf(agent.session, 'modelSelection')
+      const header = agent.session.requestHeader?.()
+      const logged = header === undefined ? undefined : {
+        provider: header.config.provider, model: header.config.model,
+        ...(header.config.reasoningEffort === undefined || header.adapterDefaults?.reasoningEffort === true
+          ? {} : { reasoningEffort: header.config.reasoningEffort }),
+      }
+      const selected = projected?.pending ?? logged ?? projected?.lastUsed
+        ?? (agent.options.provider !== undefined && agent.options.model !== undefined
+          ? { provider: agent.options.provider, model: agent.options.model, reasoningEffort: agent.options.reasoningEffort }
+          : defaults?.currentSelection())
+      if (selected === undefined) return undefined
+      return {
+        provider: selected.provider, model: selected.model,
+        ...(selected.reasoningEffort === undefined ? {} : { reasoningEffort: sidechatReasoningEffortId(selected.reasoningEffort) }),
+      }
+    },
+    assembled: undefined,
+  })
+}
