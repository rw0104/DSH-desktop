+    const text = value => { if (typeof value !== 'string' || !value) return; if (parts.at(-1)?.type === 'text') parts.at(-1).text += value; else parts.push({ type: 'text', text: value }); };
+    const image = value => { const id = value.data.toString('base64'); if (seen.has(id)) return; seen.add(id); parts.push({ type: 'image', value }); if (seen.size > (attachments.imageLimits?.maxImagesPerMessage ?? 8)) throw new LlmError('The model returned too many images for one message.', 'TOO_MANY_IMAGES'); };
