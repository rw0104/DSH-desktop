+// credentials, network calls, polling, cancellation, bounds, validation and persistence.
+const protocols = new Map();
+export function registerImageProtocol(id, adapter) {
+  if (!/^[a-z][a-z0-9-]{1,79}$/.test(id) || !adapter || typeof adapter.prepare !== 'function' || typeof adapter.normalize !== 'function')
+    throw new TypeError('An image protocol needs a stable ID, prepare() and normalize().');
+  if (protocols.has(id)) throw new Error(`Image protocol "${id}" is already registered.`);
+  const frozen = Object.freeze({ ...adapter }); protocols.set(id, frozen);
+  return () => { if (protocols.get(id) === frozen) protocols.delete(id); };
+}
+export function getImageProtocol(id) {
+  const adapter = protocols.get(id);
+  if (!adapter) throw new LlmError(`Image protocol "${id}" is not installed for the selected provider.`, 'UNSUPPORTED_PROTOCOL');
+  return adapter;
+}
+export function imageProtocolIds() { return [...protocols.keys()]; }
