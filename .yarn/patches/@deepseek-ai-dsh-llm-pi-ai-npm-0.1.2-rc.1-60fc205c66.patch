+        if (candidate.finishReason === 'MAX_TOKENS') finishReason = 'max-tokens';
+      }
+      if (record.usageMetadata) usage = { inputTokens: record.usageMetadata.promptTokenCount ?? 0, outputTokens: (record.usageMetadata.candidatesTokenCount ?? 0) + (record.usageMetadata.thoughtsTokenCount ?? 0) };
+      if (record.type === 'response.output_text.delta') text(record.delta);
+      if (record.type === 'response.output_item.done' && record.item?.type === 'image_generation_call' && record.item.result) image(raster(record.item.result));
+      if (record.type === 'response.completed') { finished = true; for (const item of record.response?.output ?? []) if (item.type === 'image_generation_call' && item.result) image(raster(item.result)); }
+      if (record.type === 'image_generation.completed') { finished = true; if (record.b64_json) image(raster(record.b64_json, record.media_type)); }
+    }
+    abort(signal);
+    if (!finished) throw new LlmError('Image stream ended before a completed response.', 'STREAM_CLOSED');
+    if (!parts.length) throw new LlmError('The selected model returned no text or image content.', 'EMPTY_RESPONSE');
+    const images = parts.filter(p => p.type === 'image');
+    const refs = images.length ? await attachments.saveImages(images.map(p => p.value)) : [];
+    abort(signal);
+    if (refs.length !== images.length) throw new LlmError('Image storage returned an incomplete result.', 'ATTACHMENT_STORE_ERROR');
+    let imageIndex = 0;
+    for (let index = 0; index < parts.length; index++) {
+      const part = parts[index];
+      yield { type: 'block-start', index, blockType: part.type };
+      if (part.type === 'text') { yield { type: 'text-delta', index, text: part.text }; yield { type: 'block-end', index, block: { type: 'text', text: part.text } }; }
+      else yield { type: 'block-end', index, block: { type: 'image', attachment: refs[imageIndex++] } };
+    }
+    if (usage) yield { type: 'usage', usage };
+    yield { type: 'finish', reason: { kind: finishReason } };
+  } catch (error) {
+    if (options.signal?.aborted) throw new LlmError('Image model request cancelled.', 'ABORTED');
+    if (deadline.aborted) throw new LlmError('Image model request timed out.', 'TIMEOUT');
+    if (error instanceof LlmError) throw error;
+    if (error?.name === 'AttachmentError') throw new LlmError(error.message, error.code ?? 'ATTACHMENT_STORE_ERROR');
+    if (error instanceof SyntaxError) throw new LlmError('The selected model returned malformed response data.', 'INVALID_RESPONSE');
+    throw new LlmError('Could not read the selected model image response.', 'TRANSPORT');
+  }
+}
