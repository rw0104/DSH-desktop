+import imageCatalog from "./model-output-catalog.js";
+
+// Desktop-owned inference: no network, active image probes, or profile writes.
+// Explicit model.input is resolved BEFORE this fallback.
+const VISUAL_NAME = /(?:^|[\s/:._-])(?:vision|vl)(?:$|[\s/:._-])/i;
+let installedInputs;
+function normalizedInput(value) {
+  if (!Array.isArray(value) || value.length === 0 || value.some(item => typeof item !== "string") || !value.includes("text")) return;
+  return value.includes("image") ? ["text", "image"] : ["text"];
+}
+function catalogInput(id) {
+  if (installedInputs === undefined) {
+    installedInputs = new Map();
+    for (const provider of getBuiltinProviders()) {
+      for (const model of getBuiltinModels(provider)) {
+        const input = normalizedInput(model.input);
+        if (input === undefined) continue;
+        if (!installedInputs.has(model.id)) installedInputs.set(model.id, input);
+        else if (JSON.stringify(installedInputs.get(model.id)) !== JSON.stringify(input)) installedInputs.set(model.id, null);
+      }
+    }
+  }
+  return installedInputs.get(id);
+}
+export function detectModelInput(entry, route = {}) {
+  if (entry.inputCapabilitySource === "unknown") return {};
+  const candidates = [entry.inputModalities, entry.input_modalities, entry.architecture?.input_modalities];
+  // Schemastery materializes [] for missing model.input: it means automatic.
+  if (!Array.isArray(entry.input) || entry.input.length > 0) candidates.push(entry.input);
+  const advertised = candidates.filter(value => value !== undefined);
+  if (advertised.length > 0) {
+    const inputs = advertised.map(normalizedInput);
+    if (inputs.some(input => input === undefined) || inputs.some(input => JSON.stringify(input) !== JSON.stringify(inputs[0]))) return { inputCapabilitySource: "unknown" };
+    return { inputModalities: inputs[0], inputCapabilitySource: "provider" };
+  }
+  const flags = [entry.supports_image_input, entry.supportsImageInput, entry.capabilities?.vision].filter(value => value !== undefined);
+  if (flags.length > 0) {
+    if (flags.some(value => typeof value !== "boolean") || flags.some(value => value !== flags[0])) return { inputCapabilitySource: "unknown" };
+    return { inputModalities: flags[0] ? ["text", "image"] : ["text"], inputCapabilitySource: "provider" };
+  }
+  const imageInput = (imageCatalog[entry.id] ?? imageCatalog['google/' + entry.id] ?? imageCatalog['openai/' + entry.id])?.inputModalities;
+  const known = aliyunImageModel(entry.id, route)?.inputModalities ?? imageInput ?? catalogInput(entry.id);
+  if (known === null) return { inputCapabilitySource: "unknown" }; // Conflicting catalogs do not justify guessing.
+  if (known !== undefined) return { inputModalities: [...known], inputCapabilitySource: "catalog" };
+  if ([entry.id, entry.name, entry.display_name].some(value => typeof value === "string" && VISUAL_NAME.test(value))) {
+    return { inputModalities: ["text", "image"], inputCapabilitySource: "name" };
+  }
+  return {};
+}
