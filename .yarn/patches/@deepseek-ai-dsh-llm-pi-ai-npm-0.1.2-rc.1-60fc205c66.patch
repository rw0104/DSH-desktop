new file mode 100644
index 0000000000000000000000000000000000000000..7e26007411489b076ee42a3bb354b97ab497fe25
--- /dev/null
+++ b/lib/model-output.js
@@ -0,0 +1,38 @@
+import catalog from './model-output-catalog.js';
+import { imageProtocolIds } from './image-protocols.js';
+import { aliyunImageModel, isAliyunImageEndpoint } from './aliyun-image.js';
+
+export const IMAGE_APIS = imageProtocolIds();
+function modalities(value) {
+  if (!Array.isArray(value) || value.length === 0 || value.some(item => typeof item !== 'string')) return;
+  const result = ['text', 'image'].filter(item => value.includes(item));
+  return result.length ? result : undefined;
+}
+export function isOpenRouterEndpoint(baseURL) {
+  try { const url = new URL(baseURL); return url.protocol === 'https:' && url.hostname === 'openrouter.ai' && !url.port && url.pathname.replace(/\/+$/, '') === '/api/v1'; } catch { return false; }
+}
+/** Distinguish image INPUT from OUTPUT and derive the wire shape from real metadata, not prompt keywords. */
+export function detectModelOutput(entry, route = {}) {
+  const raw = [entry.outputModalities, entry.output_modalities, entry.architecture?.output_modalities];
+  if (!Array.isArray(entry.output) || entry.output.length) raw.push(entry.output);
+  const declared = raw.filter(value => value !== undefined);
+  const normalized = declared.map(modalities);
+  if (normalized.some(value => value === undefined) || normalized.some(value => JSON.stringify(value) !== JSON.stringify(normalized[0]))) return {};
+  const known = aliyunImageModel(entry.id, route) ?? catalog[entry.id] ?? (route.api === 'google-generative-ai' ? catalog['google/' + entry.id] : undefined)
+    ?? (route.provider === 'openai' ? catalog['openai/' + entry.id] : undefined);
+  const output = normalized[0] ?? known?.outputModalities ?? (entry.imageGenerationApi ? ['image'] : undefined);
+  if (!output) return {};
+  const result = { outputModalities: [...output] };
+  if (!output.includes('image')) return result;
+  if (entry.imageGenerationApi) result.imageGenerationApi = entry.imageGenerationApi;
+  else if (route.imageGenerationApi) result.imageGenerationApi = route.imageGenerationApi;
+  else if (isAliyunImageEndpoint(route.baseURL)) result.imageGenerationApi = 'dashscope-images';
+  else if (route.api === 'google-generative-ai') result.imageGenerationApi = 'google-generative-ai';
+  else if ((route.provider === 'openrouter' || isOpenRouterEndpoint(route.baseURL)) && !output.includes('text')) result.imageGenerationApi = 'openrouter-images';
+  else if (route.provider === 'openai' && !output.includes('text')) result.imageGenerationApi = 'openai-images';
+  else if (route.api === 'openai-responses') result.imageGenerationApi = 'openai-responses';
+  else if (route.api === 'openai-completions' || route.provider === 'openrouter') result.imageGenerationApi = 'chat-completions';
+  const advertisedTools = Array.isArray(entry.supported_parameters) ? entry.supported_parameters.includes('tools') : undefined;
+  result.supportsTools = entry.supportsTools ?? advertisedTools ?? known?.supportsTools ?? false;
+  return result;
+}
diff --git a/lib/native-image.js b/lib/native-image.js
new file mode 100644
index 0000000000000000000000000000000000000000..9f39f0f3e7f575273f6f5f24c8cee78305e71383
--- /dev/null
+++ b/lib/native-image.js
@@ -0,0 +1,233 @@
+import { LlmError, attributionHeaders } from '@deepseek-ai/dsh-llm';
+import { getImageProtocol } from './image-protocols.js';
+import { setTimeout as delay } from 'node:timers/promises';
+
+const MAX_BODY = 64 * 1024 * 1024;
+const MAX_IMAGE = 20 * 1024 * 1024;
+const IMAGE_MIMES = new Set(['image/png', 'image/jpeg', 'image/webp', 'image/gif']);
+
+function abort(signal) { if (signal?.aborted) throw new LlmError('Image model request cancelled.', 'ABORTED'); }
+function errorCode(status, message) {
+  if (status === 403 && /region|geo.?restriction|country|territory/i.test(message)) return 'REGION_UNAVAILABLE';
+  return status === 401 || status === 403 ? 'AUTH' : status === 429 ? 'RATE_LIMIT' : status >= 500 ? 'SERVER' : 'INVALID_REQUEST';
+}
+async function* records(response, signal) {
+  const reader = response.body?.getReader();
+  if (!reader) throw new LlmError('Image model returned an empty body.', 'EMPTY_RESPONSE');
+  const declared = Number(response.headers.get('content-length'));
+  if (declared > MAX_BODY) { await reader.cancel(); throw new LlmError('Image model response exceeds 64 MiB.', 'RESPONSE_TOO_LARGE'); }
+  const stream = response.headers.get('content-type')?.includes('text/event-stream');
+  const decoder = new TextDecoder(); let buffer = '', size = 0;
+  try {
+    for (;;) {
+      abort(signal);
+      const { done, value } = await reader.read(); abort(signal);
+      if (done) { buffer += decoder.decode(); break; }
+      size += value.byteLength;
+      if (size > MAX_BODY) throw new LlmError('Image model response exceeds 64 MiB.', 'RESPONSE_TOO_LARGE');
+      buffer += decoder.decode(value, { stream: true });
+      if (stream) {
+        let split;
+        while ((split = buffer.search(/\r?\n\r?\n/)) >= 0) {
+          const separator = /^\r?\n\r?\n/.exec(buffer.slice(split))[0];
+          const event = buffer.slice(0, split); buffer = buffer.slice(split + separator.length);
+          const data = event.split(/\r?\n/).filter(line => line.startsWith('data:')).map(line => line.slice(5).trimStart()).join('\n');
+          if (data === '[DONE]') { yield { done: true }; continue; }
+          if (data) yield JSON.parse(data);
+        }
+      }
+    }
+    if (buffer.trim()) {
+      if (!stream) yield JSON.parse(buffer);
+      else {
+        const data = buffer.split(/\r?\n/).filter(line => line.startsWith('data:')).map(line => line.slice(5).trimStart()).join('\n');
+        if (data === '[DONE]') yield { done: true };
+        else if (data) yield JSON.parse(data);
+      }
+    }
+  } finally { await reader.cancel().catch(() => {}); reader.releaseLock(); }
+}
+function raster(encoded, mediaType) {
+  if (typeof encoded !== 'string' || !encoded || encoded.length > Math.ceil(MAX_IMAGE / 3) * 4 || encoded.length % 4 || /[^A-Za-z0-9+/=]/.test(encoded)) throw new LlmError('Invalid or oversized generated image.', 'INVALID_IMAGE');
+  const data = Buffer.from(encoded, 'base64');
+  if (data.toString('base64') !== encoded || data.length > MAX_IMAGE) throw new LlmError('Invalid image encoding.', 'INVALID_IMAGE');
+  const detected = data.subarray(0, 8).equals(Buffer.from([137,80,78,71,13,10,26,10])) ? 'image/png'
+    : data[0] === 255 && data[1] === 216 && data[2] === 255 ? 'image/jpeg'
+    : data.toString('ascii',0,4) === 'RIFF' && data.toString('ascii',8,12) === 'WEBP' ? 'image/webp'
+    : ['GIF87a','GIF89a'].includes(data.toString('ascii',0,6)) ? 'image/gif' : undefined;
+  const mime = mediaType ?? detected;
+  if (!IMAGE_MIMES.has(mime) || mime !== detected) throw new LlmError('The selected model returned an unsupported or mismatched image format.', 'INVALID_IMAGE');
+  return { data, mediaType: mime };
+}
+/** Persist unsolicited native image output from the ordinary chat SDK. */
+export async function saveReturnedImage(image, attachments, signal) {
+  signal?.throwIfAborted();
+  if (!attachments?.saveImages) throw new LlmError('Image output requires the existing attachment store.', 'UNSUPPORTED_CONTENT');
+  const [ref] = await attachments.saveImages([raster(image.data, image.mimeType)]);
+  signal?.throwIfAborted();
+  if (!ref) throw new LlmError('Generated image could not be persisted.', 'INVALID_IMAGE');
+  return ref;
+}
+/** Shared result download boundary: declared storage hosts only, no credentials or redirects. */
+async function downloadImage(url, signal, protocol, context) {
+  let target;
+  try { target = new URL(url); } catch { throw new LlmError('The image model returned an invalid result URL.', 'UNSUPPORTED_IMAGE_RESPONSE'); }
+  const allowed = protocol.assetURLAllowed ? protocol.assetURLAllowed(url, context)
+    : target.origin === new URL(context.base).origin || context.profile.imageResultHosts?.includes(target.hostname);
+  if (target.protocol !== 'https:' || target.username || target.password || target.port || target.hash || !allowed) throw new LlmError('The image model returned an unsupported result host.', 'UNSUPPORTED_IMAGE_RESPONSE');
