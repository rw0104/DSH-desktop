+      abort(signal);
+      if (record.error) throw new LlmError(String(record.error.message ?? 'Image generation failed.').slice(0,2000), 'PROVIDER_ERROR');
+      if (record.done) finished = true;
+      const receivedUsage = record.usage ?? record.response?.usage;
+      if (receivedUsage) usage = { inputTokens: receivedUsage.prompt_tokens ?? receivedUsage.input_tokens ?? 0, outputTokens: receivedUsage.completion_tokens ?? receivedUsage.output_tokens ?? 0 };
+      for (const choice of record.choices ?? []) {
+        const delta = choice.delta ?? choice.message ?? {};
+        if (typeof delta.content === 'string') text(delta.content);
+        else for (const part of delta.content ?? []) { if (part.type === 'text') text(part.text); else if (part.type === 'image_url') image(inline(typeof part.image_url === 'string' ? part.image_url : part.image_url?.url)); }
+        for (const part of delta.images ?? []) image(inline(typeof part.image_url === 'string' ? part.image_url : part.image_url?.url));
+        if (choice.finish_reason) finished = true;
+        if (choice.finish_reason === 'length') finishReason = 'max-tokens';
+      }
+      for (const item of record.data ?? []) if (item.b64_json) image(raster(item.b64_json, item.media_type)); else if (item.url) image(inline(item.url));
+      for (const candidate of record.candidates ?? []) {
+        for (const part of candidate.content?.parts ?? []) { if (part.text && !part.thought) text(part.text); if (part.inlineData) image(raster(part.inlineData.data, part.inlineData.mimeType)); }
