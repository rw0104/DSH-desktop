+    const delta = choice.delta ?? choice.message ?? {};
+    if (typeof delta.content === 'string') text(delta.content);
+    else for (const part of delta.content ?? []) { if (part.type === 'text') text(part.text); else if (part.type === 'image_url') url(typeof part.image_url === 'string' ? part.image_url : part.image_url?.url); }
