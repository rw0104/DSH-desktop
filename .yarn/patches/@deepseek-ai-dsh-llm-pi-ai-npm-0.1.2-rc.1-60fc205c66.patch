+++ b/lib/native-image.js
@@ -0,0 +1,220 @@
+import { LlmError, attributionHeaders } from '@deepseek-ai/dsh-llm';
+
+const MAX_BODY = 64 * 1024 * 1024;
+const MAX_IMAGE = 20 * 1024 * 1024;
+const IMAGE_MIMES = new Set(['image/png', 'image/jpeg', 'image/webp', 'image/gif']);
+
+function abort(signal) { if (signal?.aborted) throw new LlmError('Image model request cancelled.', 'ABORTED'); }
+function errorCode(status, message) {
+  if (status === 403 && /region|geo.?restriction|country|territory/i.test(message)) return 'REGION_UNAVAILABLE';
+  return status === 401 || status === 403 ? 'AUTH' : status === 429 ? 'RATE_LIMIT' : status >= 500 ? 'SERVER' : 'INVALID_REQUEST';
+}
+async function* records(response, signal) {
+  const reader = response.body?.getReader();
+  if (!reader) throw new LlmError('Image model returned an empty body.', 'EMPTY_RESPONSE');
+  const declared = Number(response.headers.get('content-length'));
+  if (declared > MAX_BODY) { await reader.cancel(); throw new LlmError('Image model response exceeds 64 MiB.', 'RESPONSE_TOO_LARGE'); }
+  const stream = response.headers.get('content-type')?.includes('text/event-stream');
+  const decoder = new TextDecoder(); let buffer = '', size = 0;
+  try {
+    for (;;) {
+      abort(signal);
+      const { done, value } = await reader.read(); abort(signal);
+      if (done) { buffer += decoder.decode(); break; }
+      size += value.byteLength;
+      if (size > MAX_BODY) throw new LlmError('Image model response exceeds 64 MiB.', 'RESPONSE_TOO_LARGE');
+      buffer += decoder.decode(value, { stream: true });
+      if (stream) {
+        let split;
+        while ((split = buffer.search(/\r?\n\r?\n/)) >= 0) {
+          const separator = /^\r?\n\r?\n/.exec(buffer.slice(split))[0];
+          const event = buffer.slice(0, split); buffer = buffer.slice(split + separator.length);
+          const data = event.split(/\r?\n/).filter(line => line.startsWith('data:')).map(line => line.slice(5).trimStart()).join('\n');
+          if (data === '[DONE]') { yield { done: true }; continue; }
+          if (data) yield JSON.parse(data);
+        }
+      }
+    }
+    if (buffer.trim()) {
+      if (!stream) yield JSON.parse(buffer);
+      else {
+        const data = buffer.split(/\r?\n/).filter(line => line.startsWith('data:')).map(line => line.slice(5).trimStart()).join('\n');
+        if (data === '[DONE]') yield { done: true };
+        else if (data) yield JSON.parse(data);
+      }
+    }
+  } finally { await reader.cancel().catch(() => {}); reader.releaseLock(); }
+}
+function raster(encoded, mediaType) {
+  if (typeof encoded !== 'string' || !encoded || encoded.length > Math.ceil(MAX_IMAGE / 3) * 4 || encoded.length % 4 || /[^A-Za-z0-9+/=]/.test(encoded)) throw new LlmError('Invalid or oversized generated image.', 'INVALID_IMAGE');
+  const data = Buffer.from(encoded, 'base64');
+  if (data.toString('base64') !== encoded || data.length > MAX_IMAGE) throw new LlmError('Invalid image encoding.', 'INVALID_IMAGE');
+  const detected = data.subarray(0, 8).equals(Buffer.from([137,80,78,71,13,10,26,10])) ? 'image/png'
+    : data[0] === 255 && data[1] === 216 && data[2] === 255 ? 'image/jpeg'
+    : data.toString('ascii',0,4) === 'RIFF' && data.toString('ascii',8,12) === 'WEBP' ? 'image/webp'
+    : ['GIF87a','GIF89a'].includes(data.toString('ascii',0,6)) ? 'image/gif' : undefined;
+  const mime = mediaType ?? detected;
+  if (!IMAGE_MIMES.has(mime) || mime !== detected) throw new LlmError('The selected model returned an unsupported or mismatched image format.', 'INVALID_IMAGE');
+  return { data, mediaType: mime };
+}
+/** Persist unsolicited native image output from the ordinary chat SDK. */
+export async function saveReturnedImage(image, attachments, signal) {
+  signal?.throwIfAborted();
+  if (!attachments?.saveImages) throw new LlmError('Image output requires the existing attachment store.', 'UNSUPPORTED_CONTENT');
+  const [ref] = await attachments.saveImages([raster(image.data, image.mimeType)]);
+  signal?.throwIfAborted();
+  if (!ref) throw new LlmError('Generated image could not be persisted.', 'INVALID_IMAGE');
+  return ref;
+}
+function inline(url) {
+  const match = typeof url === 'string' && /^data:(image\/[a-z0-9.+-]+);base64,([\s\S]+)$/i.exec(url);
+  if (!match) throw new LlmError('The selected model returned an image URL instead of inline image bytes.', 'UNSUPPORTED_IMAGE_RESPONSE');
+  return raster(match[2], match[1].toLowerCase());
+}
+function contextMessage(message) {
+  return !['skill-catalog'].includes(message.source?.kind) && !(message.source?.kind === 'plugin' && ['@deepseek-ai/dsh-system-prompt', 'dsh-system-prompt'].includes(message.source.plugin));
+}
+/** Older text SDKs cannot encode assistant image parts. Carry them as explicitly labelled references. */
+export function projectAssistantImageHistory(options, model) {
+  if (!options.messages.some(m => m.role === 'assistant' && m.content.some(b => b.type === 'image'))) return options;
+  const messages = options.messages.flatMap(message => {
+    if (message.role !== 'assistant' || !message.content.some(b => b.type === 'image')) return [message];
+    const images = message.content.filter(b => b.type === 'image');
+    const content = message.content.filter(b => b.type !== 'image');
+    return [...(content.length ? [{ ...message, content }] : []), { ...message, role: 'user', source: { kind: 'plugin', plugin: 'dsh-image-history' }, content: [
+      { type: 'text', text: 'Reference images generated in the preceding assistant reply.' },
+      ...images.map(b => model.input.includes('image') ? b : { type: 'text', text: `[Generated image: ${b.attachment.attachmentId}]` }),
+    ] }];
+  });
+  return { ...options, messages };
+}
+async function messagesFor(options, attachments, profile, signal) {
+  const messages = []; let imageBytes = 0;
+  const read = async ref => {
+    const image = await attachments.readImageRequest(ref, { maxPixels: profile.requestImagePixelBudget, maxBytes: profile.requestImageMaxBytes }, signal);
+    abort(signal); imageBytes += image.data.byteLength;
+    if (imageBytes > profile.maxRequestImageBytes) throw new LlmError('Image references exceed the configured request size.', 'REQUEST_TOO_LARGE');
+    return `data:${image.mediaType};base64,${Buffer.from(image.data).toString('base64')}`;
+  };
+  for (const message of options.messages.filter(contextMessage)) {
+    const content = [];
+    for (const part of message.content) {
+      if (part.type === 'text' && part.text) content.push({ type: 'text', text: part.text });
+      else if (part.type === 'image') content.push({ type: 'image_url', image_url: { url: await read(part.attachment) } });
+      else if (part.type === 'tool-result') {
+        for (const block of part.content) {
+          if (block.type === 'text') content.push({ type: 'text', text: block.text });
+          else if (block.type === 'image') content.push({ type: 'image_url', image_url: { url: await read(block.attachment) } });
+        }
+      }
+    }
+    if (message.role === 'assistant' && content.some(p => p.type === 'image_url')) {
+      const text = content.filter(p => p.type === 'text'), images = content.filter(p => p.type === 'image_url');
+      if (text.length) messages.push({ role: 'assistant', content: text });
+      messages.push({ role: 'user', content: [{ type: 'text', text: 'Reference images from the preceding assistant reply.' }, ...images] });
+    } else if (content.length) messages.push({ role: message.role === 'assistant' ? 'assistant' : 'user', content });
+  }
+  return messages;
+}
+/** One native model request through its existing provider/auth snapshot. No tools, extra provider or route settings. */
+export async function* streamNativeImage(options, model, profile, models, attachments, explicitKey) {
+  if (!attachments?.saveImages) throw new LlmError('Image output requires the existing attachment store.', 'UNSUPPORTED_CONTENT');
+  const deadline = AbortSignal.timeout(profile.timeoutMs ?? profile.streamIdleTimeoutMs ?? 300000);
+  const signal = AbortSignal.any([...(options.signal ? [options.signal] : []), deadline]);
+  try {
+    abort(signal);
+    const resolved = await models.getAuth(model, { ...(explicitKey ? { apiKey: explicitKey } : {}), signal });
+    abort(signal);
+    const key = explicitKey ?? resolved?.auth.apiKey;
+    const base = (resolved?.auth.baseUrl ?? model.baseUrl).replace(/\/+$/, '');
+    const headers = new Headers({ ...model.headers, ...resolved?.auth.headers, ...profile.headers, ...attributionHeaders(), 'content-type': 'application/json' });
+    if (key) headers.set(model.imageGenerationApi === 'google-generative-ai' ? 'x-goog-api-key' : 'authorization', model.imageGenerationApi === 'google-generative-ai' ? key : `Bearer ${key}`);
+    if (!key && !headers.has('authorization')) throw new LlmError('The selected provider has no configured credential.', 'MISSING_CREDENTIAL');
+    const messages = await messagesFor(options, attachments, profile, signal);
+    let endpoint, body;
+    if (model.imageGenerationApi === 'google-generative-ai') {
+      endpoint = `${base}/models/${encodeURIComponent(model.id)}:generateContent`;
+      body = { contents: messages.map(m => ({ role: m.role === 'assistant' ? 'model' : 'user', parts: m.content.map(p => p.type === 'text' ? { text: p.text } : (() => { const image = inline(p.image_url.url); return { inlineData: { data: image.data.toString('base64'), mimeType: image.mediaType } } })()) })),
+        generationConfig: { responseModalities: model.outputModalities.map(x => x.toUpperCase()) },
+        ...(options.system ? { systemInstruction: { parts: [{ text: options.system }] } } : {}) };
+    } else if (model.imageGenerationApi === 'openrouter-images' || model.imageGenerationApi === 'openai-images') {
+      endpoint = `${base}/${model.imageGenerationApi === 'openrouter-images' ? 'images' : 'images/generations'}`;
+      const prompt = messages.map(m => m.content.filter(p => p.type === 'text').map(p => p.text).join('\n')).filter(Boolean).join('\n\n');
+      const references = messages.flatMap(m => m.content.filter(p => p.type === 'image_url'));
+      if (references.length && model.imageGenerationApi === 'openai-images') {
+        endpoint = `${base}/images/edits`;
+        body = new FormData(); body.set('model', model.id); body.set('prompt', prompt);
+        references.forEach((ref, index) => { const image = inline(ref.image_url.url); body.append(references.length === 1 ? 'image' : 'image[]', new Blob([image.data], { type: image.mediaType }), `reference-${index + 1}.${image.mediaType.slice(6)}`); });
+        headers.delete('content-type');
+      } else body = { model: model.id, prompt, ...(references.length ? { input_references: references } : {}), ...(/^dall-e-[23]$/.test(model.id) ? { response_format: 'b64_json' } : {}) };
+    } else if (model.imageGenerationApi === 'openai-responses') {
+      endpoint = `${base}/responses`;
+      body = { model: model.id, input: messages.map(m => m.role === 'assistant' ? { role: 'assistant', content: m.content.map(p => p.text ?? '').join('\n') } : { role: 'user', content: m.content.map(p => p.type === 'text' ? { type: 'input_text', text: p.text } : { type: 'input_image', image_url: p.image_url.url }) }),
+        ...(options.system ? { instructions: options.system } : {}), tools: [{ type: 'image_generation' }], stream: true };
+    } else if (model.imageGenerationApi === 'chat-completions') {
+      endpoint = `${base}/chat/completions`;
+      body = { model: model.id, messages: [...(options.system ? [{ role: 'system', content: options.system }] : []), ...messages], stream: true,
+        modalities: model.outputModalities, ...(options.maxTokens === undefined ? {} : { max_tokens: options.maxTokens }), ...(options.temperature === undefined ? {} : { temperature: options.temperature }) };
+    } else throw new LlmError(`Image output protocol is not supported for the selected model "${model.id}".`, 'UNSUPPORTED_PROTOCOL');
+    const response = await fetch(endpoint, { method: 'POST', headers, body: body instanceof FormData ? body : JSON.stringify(body), redirect: 'error', signal });
+    abort(signal);
+    if (!response.ok) {
+      let detail = '';
+      try { for await (const record of records(response, signal)) { detail = String(record.error?.message ?? record.message ?? ''); break; } } catch {}
+      if (key) detail = detail.split(key).join('[redacted]');
+      throw new LlmError(`Image model HTTP ${response.status}: ${detail.slice(0, 2000) || response.statusText}`, errorCode(response.status, detail), { status: response.status });
