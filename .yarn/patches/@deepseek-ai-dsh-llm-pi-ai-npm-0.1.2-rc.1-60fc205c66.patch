@@ -0,0 +1,32 @@
+// Model Studio native image contracts: help.aliyun.com/zh/model-studio/qwen-image-api
+// Endpoint inference is limited to documented Alibaba hosts; custom gateways retain their selected protocol.
+const IMAGE_MODELS = new Set(['qwen-image-2.0-pro', 'qwen-image-2.0-pro-2026-03-03', 'qwen-image-2.0-pro-2026-04-22', 'qwen-image-2.0-pro-2026-06-22', 'qwen-image-2.0', 'qwen-image-2.0-2026-03-03']);
+export function isAliyunImageEndpoint(baseURL) {
+  try {
+    const u = new URL(baseURL);
+    return u.protocol === 'https:' && !u.port && !u.username && !u.password && !u.search && !u.hash
+      && (/^[a-z0-9-]+\.(?:cn-beijing|ap-southeast-1|eu-central-1|ap-northeast-1)\.maas\.aliyuncs\.com$/.test(u.hostname)
+        || ['dashscope.aliyuncs.com', 'dashscope-intl.aliyuncs.com'].includes(u.hostname))
+      && ['/compatible-mode/v1', '/api/v1'].includes(u.pathname.replace(/\/+$/, ''));
+  } catch { return false; }
+}
+export function aliyunImageModel(id, route = {}) {
+  return isAliyunImageEndpoint(route.baseURL) && IMAGE_MODELS.has(id)
+    ? { inputModalities: ['text', 'image'], outputModalities: ['image'], imageGenerationApi: 'dashscope-images', supportsTools: false } : undefined;
+}
+export function aliyunImageURL(value) {
+  try {
+    const u = new URL(value);
+    return u.protocol === 'https:' && !u.port && !u.username && !u.password && !u.hash
+      && /^dashscope-[a-z0-9-]+\.oss-[a-z0-9-]+\.aliyuncs\.com$/.test(u.hostname);
+  } catch { return false; }
+}
+// The synchronous image API accepts one user message, not the Agent system/skill/tool history.
+export function aliyunImageTurn(options) {
+  const i = options.messages.findLastIndex(m => m.role === 'user' && m.source?.kind === 'user');
+  if (i < 0) return { ...options, messages: [] };
+  const current = options.messages[i];
+  const previous = current.content.some(b => b.type === 'image') ? undefined
+    : options.messages.slice(0, i).findLast(m => m.role === 'assistant' && m.content.some(b => b.type === 'image'));
+  return { ...options, messages: [...(previous ? [{ ...previous, content: previous.content.filter(b => b.type === 'image') }] : []), current] };
+}
