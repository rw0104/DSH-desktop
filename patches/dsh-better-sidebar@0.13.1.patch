+      && typeof control.cols === 'number' && typeof control.rows === 'number'
+    ) {
+      const dims = clampDims(control.cols, control.rows)
+      handle.pty.resize(dims.cols, dims.rows)
+      terminalRegistry?.applyAdapterEvent({ sessionId: handle.sessionId, source: 'ui', sourceId: handle.tabId, kind: 'resized', data: dims })
+    } else {
+      terminalRegistry?.applyAdapterEvent({ sessionId: handle.sessionId, source: 'ui', sourceId: handle.tabId, kind: 'input', data: { text } })
+      handle.pty.write(text)
+    }
+  })
+  ws.on('close', () => {
+    dataSub.dispose()
+    exitSub.dispose()
+    // A bare socket drop (refresh, tab switch, or exited shell) leaves the
+    // process registered for a grace period. Reconnect replaces exited
+    // handles immediately and reuses only live ones.
+    ptyManager.scheduleClose(handle.key, reconnectGraceMs)
+    terminalRegistry?.applyAdapterEvent({ sessionId: handle.sessionId, source: 'ui', sourceId: handle.tabId, kind: 'disconnected', data: { reason: 'socket closed' } })
+  })
